from collections import Counter
text = input("Введите строку: ").lower()
text = text.replace(" ", "")
counter = Counter(text)
print(f"Количество каждого символа:")
for char, count in sorted(counter.items()):
    print(f"  '{char}' — {count} раз(а)")
print(f"3 самых частых символа:")
for char, count in counter.most_common(3):
    print(f"  '{char}' — {count} раз(а)")
