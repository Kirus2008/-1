a = int(input("Введите целое число: "))
if a%2==0:
    print(f"Число {a} - чётное")
else:
    print(f"Число {a} - нечётное")
if a>0:
    print(f"Число {a} - положительное")
elif a==0:
    print(f"Число {a} - ноль")
else:
    print(f"Число {a} - отрицательное")
if a in [10,50]:
    print(f"Число {a} принадлежит диапазону [10,50]")
else:
    print(f"Число {a} не принадлежит диапазону [10,50]")
